    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pribadi jemaat SIB Toburon (pemilik akun dapat membaca/mengedit; Admin dapat memantau daftar pengguna login Google).",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Nama tampilan jemaat (1-80 karakter)"
        },
        "email": {
          "type": "string",
          "description": "Alamat email akun Google pengguna (opsional, maks 160 karakter)"
        },
        "fellowshipGroup": {
          "type": "string",
          "enum": ["UMUM", "PEMUDA", "KAUM_IBU", "KAUM_BAPAK", "SEKOLAH_MINGGU", "PELAYAN"],
          "description": "Kelompok persekutuan jemaat"
        },
        "photoBase64": {
          "type": "string",
          "description": "Foto profil jemaat terkompresi Base64 opsional (maks 160000 karakter)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan profil (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan profil (FieldValue.serverTimestamp())"
        },
