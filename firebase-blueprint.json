{
  "entities": {
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "Berita terkini dan warta jemaat SIB Toburon yang disinkronkan secara real-time.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Judul berita (3-160 karakter)"
        },
        "summary": {
          "type": "string",
          "description": "Ringkasan singkat berita (5-320 karakter)"
        },
        "content": {
          "type": "string",
          "description": "Isi lengkap warta atau berita gereja (10-5000 karakter)"
        },
        "category": {
          "type": "string",
          "description": "Kod kategori berita dinamik (1-40 karakter)"
        },
        "authorId": {
          "type": "string",
          "description": "UID admin penulis berita"
        },
        "authorName": {
          "type": "string",
          "description": "Nama penulis atau tim redaksi (1-80 karakter)"
        },
        "coverPreset": {
          "type": "string",
          "enum": ["SANCTUARY", "WORSHIP", "FELLOWSHIP", "CUSTOM"],
          "description": "Tema sampul bawaan atau kustom"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL gambar opsional (maks 1000 karakter)"
        },
        "imageBase64": {
          "type": "string",
          "description": "Gambar terkompresi Base64 opsional dari Photo Picker (maks 260000 karakter)"
        },
        "pinned": {
          "type": "boolean",
          "description": "Penanda berita utama yang disematkan"
        },
        "published": {
          "type": "boolean",
          "description": "Status publikasi berita ke seluruh jemaat"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan (FieldValue.serverTimestamp(), immutable)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "title",
        "summary",
        "content",
        "category",
        "authorId",
        "authorName",
        "coverPreset",
        "pinned",
        "published",
        "createdAt",
        "updatedAt"
      ]
    },
    "NewsComment": {
      "title": "NewsComment",
      "description": "Komen dan balasan jemaat pada artikel berita dan warta gereja.",
      "type": "object",
      "properties": {
        "newsId": {
          "type": "string",
          "description": "ID dokumen berita induk"
        },
        "authorId": {
          "type": "string",
          "description": "UID pengguna yang menulis komen"
        },
        "authorName": {
          "type": "string",
          "description": "Nama paparan penulis komen (1-80 karakter)"
        },
        "text": {
          "type": "string",
          "description": "Kandungan komen atau balasan (1-500 karakter)"
        },
        "parentCommentId": {
          "type": "string",
          "description": "ID komen induk sekiranya ini merupakan balasan (pilihan)"
        },
        "replyToAuthorName": {
          "type": "string",
          "description": "Nama pengguna yang dibalas (pilihan, 1-80 karakter)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Masa komen dihantar (FieldValue.serverTimestamp(), immutable)"
        }
      },
      "required": ["newsId", "authorId", "authorName", "text", "createdAt"]
    },
    "ChurchSchedule": {
      "title": "ChurchSchedule",
      "description": "Jadwal ibadah dan kegiatan pelayanan SIB Toburon.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Nama kegiatan atau ibadah (3-140 karakter)"
        },
        "description": {
          "type": "string",
          "description": "Detail kegiatan dan catatan jemaat (1-1500 karakter)"
        },
        "category": {
          "type": "string",
          "description": "Kod kategori kegiatan dinamik (1-40 karakter)"
        },
        "dateLabel": {
          "type": "string",
          "description": "Label tanggal atau hari (3-60 karakter)"
        },
        "timeLabel": {
          "type": "string",
          "description": "Label jam kegiatan (3-40 karakter)"
        },
        "location": {
          "type": "string",
          "description": "Lokasi kegiatan (2-120 karakter)"
        },
        "speaker": {
          "type": "string",
          "description": "Pengkhotbah atau koordinator (0-100 karakter)"
        },
        "sortOrder": {
          "type": "integer",
          "description": "Urutan kronologis YYYYMMDDHHmm atau angka urutan"
        },
        "recurring": {
          "type": "boolean",
          "description": "Penanda jadwal rutin mingguan"
        },
        "published": {
          "type": "boolean",
          "description": "Status publikasi jadwal ke seluruh jemaat"
        },
        "featuredInNews": {
          "type": "boolean",
          "description": "Penanda kegiatan penting yang ditampilkan di atas pencarian pada menu utama Berita"
        },
        "authorId": {
          "type": "string",
          "description": "UID admin pembuat jadwal"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan (FieldValue.serverTimestamp(), immutable)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "dateLabel",
        "timeLabel",
        "location",
        "speaker",
        "sortOrder",
        "recurring",
        "published",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "GalleryPhoto": {
      "title": "GalleryPhoto",
      "description": "Foto dokumentasi kegiatan gereja pada galeri foto interaktif.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Judul foto (2-120 karakter)"
        },
        "caption": {
          "type": "string",
          "description": "Keterangan foto (0-600 karakter)"
        },
        "category": {
          "type": "string",
          "enum": ["IBADAH", "PEMUDA", "SEKOLAH_MINGGU", "PELAYANAN", "UMUM"],
          "description": "Kategori album galeri"
        },
        "eventDate": {
          "type": "string",
          "description": "Tanggal dokumentasi (2-50 karakter)"
        },
        "coverPreset": {
          "type": "string",
          "enum": ["SANCTUARY", "WORSHIP", "FELLOWSHIP", "CUSTOM"],
          "description": "Gambar bawaan atau kustom"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL gambar HTTPS opsional (maks 1000 karakter)"
        },
        "imageBase64": {
          "type": "string",
          "description": "Gambar utama terkompresi Base64 opsional (maks 260000 karakter)"
        },
        "extraImagesBase64": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Senarai gambar tambahan Base64 dalam satu muat naik album galeri (maks 7 gambar tambahan, jumlah maks 8 gambar)"
        },
        "likesCount": {
          "type": "integer",
          "description": "Jumlah apresiasi jemaat"
        },
        "published": {
          "type": "boolean",
          "description": "Status publikasi foto ke galeri jemaat"
        },
        "authorId": {
          "type": "string",
          "description": "UID admin pengunggah"
        },
        "photographerName": {
          "type": "string",
          "description": "Nama fotografer atau tim multimedia (1-80 karakter)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu unggah (FieldValue.serverTimestamp(), immutable)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "title",
        "caption",
        "category",
        "eventDate",
        "coverPreset",
        "likesCount",
        "published",
        "authorId",
        "photographerName",
        "createdAt",
        "updatedAt"
      ]
    },
