    "NotificationEvent": {
      "title": "NotificationEvent",
      "description": "Antrean/catatan notifikasi push real-time untuk berita, jadwal baru, dan pendaftaran ahli jemaat baharu (notifikasi ahli baharu khusus untuk Admin).",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Judul notifikasi (2-160 karakter)"
        },
        "body": {
          "type": "string",
          "description": "Ringkasan isi notifikasi (2-320 karakter)"
        },
        "eventType": {
          "type": "string",
          "enum": ["NEWS", "SCHEDULE", "MEMBER_REGISTERED"],
          "description": "Jenis acara notifikasi (NEWS/SCHEDULE untuk jemaat, MEMBER_REGISTERED khusus Admin)"
        },
        "targetId": {
          "type": "string",
          "description": "ID dokumen berita, jadwal, atau ahli baharu tujuan deep-link"
        },
        "topic": {
          "type": "string",
          "enum": ["sib_toburon_news", "sib_toburon_schedules", "sib_toburon_admin_members"],
          "description": "Topik FCM tujuan siaran"
        },
        "published": {
          "type": "boolean",
          "description": "True untuk siaran jemaat (NEWS/SCHEDULE); false untuk notifikasi khusus Admin (MEMBER_REGISTERED)"
        },
        "authorId": {
          "type": "string",
          "description": "UID admin penerbit atau UID jemaat yang mendaftar diri"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu penerbitan notifikasi (FieldValue.serverTimestamp())"
        }
      },
      "required": ["title", "body", "eventType", "targetId", "topic", "published", "authorId", "createdAt"]
    },
    "FcmTokenRecord": {
      "title": "FcmTokenRecord",
      "description": "Token perangkat FCM dan preferensi notifikasi pribadi jemaat (terisolasi per pemilik akun).",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Registration token Firebase Cloud Messaging perangkat (10-512 karakter)"
        },
        "newsEnabled": {
          "type": "boolean",
          "description": "Status langganan notifikasi Berita Terkini"
        },
        "schedulesEnabled": {
          "type": "boolean",
          "description": "Status langganan notifikasi Jadwal Kegiatan Gereja"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan token terakhir (FieldValue.serverTimestamp())"
        }
      },
      "required": ["token", "newsEnabled", "schedulesEnabled", "updatedAt"]
    },
