rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Pure token check (0 DB reads) for bootstrapped church admin with verified email
    function isBootstrappedAdmin() {
      return isSignedIn() &&
        'email_verified' in request.auth.token &&
        'email' in request.auth.token &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'Raxxon47@gmail.com' ||
         request.auth.token.email == 'raxxon47@gmail.com');
    }

    // Full admin verification including delegated church admins in /admins/{uid}
    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION BLUEPRINTS ---

    function isValidNewsArticle(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 160 &&
        data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 320 &&
        data.content is string && data.content.size() >= 10 && data.content.size() <= 5000 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 && data.category.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.coverPreset in ['SANCTUARY', 'WORSHIP', 'FELLOWSHIP', 'CUSTOM'] &&
        data.pinned is bool &&
        data.published is bool &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
        (!('imageBase64' in data) || data.imageBase64 == null || (data.imageBase64 is string && data.imageBase64.size() <= 260000)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidNewsComment(data, expectedNewsId) {
      return isValidId(data.newsId) &&
        data.newsId == expectedNewsId &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        (!('parentCommentId' in data) || data.parentCommentId == null || (
          isValidId(data.parentCommentId) &&
          exists(/databases/$(database)/documents/news/$(expectedNewsId)/comments/$(data.parentCommentId))
        )) &&
        (!('replyToAuthorName' in data) || data.replyToAuthorName == null || (
          data.replyToAuthorName is string && data.replyToAuthorName.size() >= 1 && data.replyToAuthorName.size() <= 80
        )) &&
        isValidTimestamp(data.createdAt);
    }

    function canReadNewsArticle(newsId) {
      return isValidId(newsId) &&
        exists(/databases/$(database)/documents/news/$(newsId)) && (
          get(/databases/$(database)/documents/news/$(newsId)).data.published == true ||
          (isSignedIn() && (
            get(/databases/$(database)/documents/news/$(newsId)).data.authorId == request.auth.uid ||
            isAdmin()
          ))
        );
    }

    function isValidChurchSchedule(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1500 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 && data.category.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.dateLabel is string && data.dateLabel.size() >= 3 && data.dateLabel.size() <= 60 &&
        data.timeLabel is string && data.timeLabel.size() >= 3 && data.timeLabel.size() <= 40 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 120 &&
        data.speaker is string && data.speaker.size() <= 100 &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 9999999999999 &&
        data.recurring is bool &&
        data.published is bool &&
        (!('featuredInNews' in data) || data.featuredInNews is bool) &&
        isValidId(data.authorId) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidGalleryPhoto(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.caption is string && data.caption.size() <= 600 &&
        data.category in ['IBADAH', 'PEMUDA', 'SEKOLAH_MINGGU', 'PELAYANAN', 'UMUM'] &&
        data.eventDate is string && data.eventDate.size() >= 2 && data.eventDate.size() <= 50 &&
        data.coverPreset in ['SANCTUARY', 'WORSHIP', 'FELLOWSHIP', 'CUSTOM'] &&
        data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000 &&
        data.published is bool &&
        isValidId(data.authorId) &&
        data.photographerName is string && data.photographerName.size() >= 1 && data.photographerName.size() <= 80 &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
        (!('imageBase64' in data) || data.imageBase64 == null || (data.imageBase64 is string && data.imageBase64.size() <= 260000)) &&
        (!('extraImagesBase64' in data) || data.extraImagesBase64 == null || (data.extraImagesBase64 is list && data.extraImagesBase64.size() <= 7)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidGalleryComment(data, expectedPhotoId) {
      return isValidId(data.photoId) &&
        data.photoId == expectedPhotoId &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        (!('parentCommentId' in data) || data.parentCommentId == null || (
          isValidId(data.parentCommentId) &&
          exists(/databases/$(database)/documents/gallery_photos/$(expectedPhotoId)/comments/$(data.parentCommentId))
        )) &&
        (!('replyToAuthorName' in data) || data.replyToAuthorName == null || (
          data.replyToAuthorName is string && data.replyToAuthorName.size() >= 1 && data.replyToAuthorName.size() <= 80
        )) &&
        isValidTimestamp(data.createdAt);
    }

    function canReadGalleryPhoto(photoId) {
      return isValidId(photoId) &&
        exists(/databases/$(database)/documents/gallery_photos/$(photoId)) && (
          get(/databases/$(database)/documents/gallery_photos/$(photoId)).data.published == true ||
          (isSignedIn() && (
            get(/databases/$(database)/documents/gallery_photos/$(photoId)).data.authorId == request.auth.uid ||
            isAdmin()
          ))
        );
    }

    function isValidAdminMember(data) {
      return data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 60 &&
        isValidId(data.addedBy) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.fellowshipGroup in ['UMUM', 'PEMUDA', 'KAUM_IBU', 'KAUM_BAPAK', 'SEKOLAH_MINGGU', 'PELAYAN'] &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('photoBase64' in data) || data.photoBase64 == null || (data.photoBase64 is string && data.photoBase64.size() <= 160000)) &&
        (!('lastLoginAt' in data) || isValidTimestamp(data.lastLoginAt)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidUserBookmark(data) {
      return isValidId(data.itemId) &&
        data.itemType in ['NEWS', 'SCHEDULE'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidPhotoLike(data, expectedPhotoId) {
      return isValidId(data.photoId) &&
        data.photoId == expectedPhotoId &&
        isValidTimestamp(data.createdAt);
    }

    function isValidNotificationEvent(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.body is string && data.body.size() >= 2 && data.body.size() <= 320 &&
        data.eventType in ['NEWS', 'SCHEDULE', 'MEMBER_REGISTERED'] &&
        isValidId(data.targetId) &&
        data.topic in ['sib_toburon_news', 'sib_toburon_schedules', 'sib_toburon_admin_members'] &&
        data.published is bool &&
        isValidId(data.authorId) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidFcmToken(data) {
      return data.token is string && data.token.size() >= 10 && data.token.size() <= 512 &&
        data.newsEnabled is bool &&
        data.schedulesEnabled is bool &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidChurchMemberPublic(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.gender in ['LELAKI', 'PEREMPUAN'] &&
        data.baptismStatus in ['DIBAPTIS', 'BELUM_DIBAPTIS'] &&
        (!('passportPhotoBase64' in data) || data.passportPhotoBase64 == null || (data.passportPhotoBase64 is string && data.passportPhotoBase64.size() <= 160000)) &&
        data.published is bool &&
        isValidId(data.authorId) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidChurchMemberDetail(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.gender in ['LELAKI', 'PEREMPUAN'] &&
        data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.baptismStatus in ['DIBAPTIS', 'BELUM_DIBAPTIS'] &&
        data.denomination is string && data.denomination.size() <= 80 &&
        (data.baptismStatus != 'DIBAPTIS' || data.denomination.size() >= 1) &&
        (!('maritalStatus' in data) || data.maritalStatus in ['BUJANG', 'BERKAHWIN', 'BALU_DUDA', 'BERCERAI']) &&
        (!('myKadNumber' in data) || data.myKadNumber == null || (data.myKadNumber is string && data.myKadNumber.size() <= 30)) &&
        (!('spouseName' in data) || data.spouseName == null || (data.spouseName is string && data.spouseName.size() <= 120)) &&
        (!('sibMembershipNumber' in data) || data.sibMembershipNumber == null || (data.sibMembershipNumber is string && data.sibMembershipNumber.size() <= 40)) &&
        (!('passportPhotoBase64' in data) || data.passportPhotoBase64 == null || (data.passportPhotoBase64 is string && data.passportPhotoBase64.size() <= 160000)) &&
        (!('memberEmail' in data) || data.memberEmail == null || (data.memberEmail is string && data.memberEmail.size() <= 160)) &&
        isValidId(data.authorId) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token;
    }

    function isOwnMemberDetail(data) {
      return hasVerifiedEmail() &&
        'memberEmail' in data &&
        data.memberEmail is string &&
        data.memberEmail == request.auth.token.email.lower();
    }

    function isOwnMemberRecord(memberId) {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/church_member_details/$(memberId)) &&
        isOwnMemberDetail(get(/databases/$(database)/documents/church_member_details/$(memberId)).data);
    }

    function isValidAppVersionConfig(data) {
      return data.latestVersionCode is int &&
        data.latestVersionCode >= 1 &&
        data.latestVersionCode <= 1000000 &&
        data.latestVersionName is string &&
        data.latestVersionName.size() >= 1 &&
        data.latestVersionName.size() <= 32 &&
        data.releaseNotes is string &&
        data.releaseNotes.size() <= 1000 &&
        data.updateUrl is string &&
        data.updateUrl.size() <= 500 &&
        (data.updateUrl == '' || data.updateUrl.matches('^https://.*')) &&
        data.forceUpdate is bool &&
        isValidId(data.updatedBy) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidDynamicCategory(data) {
      return data.code is string &&
        data.code.size() >= 1 &&
        data.code.size() <= 40 &&
        data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.labelMs is string &&
        data.labelMs.size() >= 1 &&
        data.labelMs.size() <= 60 &&
        data.labelEn is string &&
        data.labelEn.size() >= 1 &&
        data.labelEn.size() <= 60 &&
        data.sortOrder is int &&
        data.sortOrder >= 0 &&
        data.sortOrder <= 100000 &&
        isValidId(data.updatedBy) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---

    // 1. Berita Terkini (/news/{newsId})
    match /news/{newsId} {
      allow get: if isValidId(newsId) && (
        existing().published == true ||
        (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin()))
      );

      // Cost-optimized list check (no get/exists inside allow list); Guests can query published == true only
      allow list: if resource.data.published == true || (
        isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          isBootstrappedAdmin()
        )
      );

      allow create: if isSignedIn() &&
        isValidId(newsId) &&
        isValidNewsArticle(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'summary', 'content', 'category', 'authorId', 'authorName',
          'coverPreset', 'pinned', 'published', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'summary', 'content', 'category', 'authorId', 'authorName',
          'coverPreset', 'pinned', 'published', 'imageUrl', 'imageBase64',
          'createdAt', 'updatedAt'
        ]) &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(newsId) &&
        isValidNewsArticle(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'summary', 'content', 'category', 'authorName',
          'coverPreset', 'pinned', 'published', 'imageUrl', 'imageBase64', 'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isSignedIn() && isValidId(newsId) && isAdmin();

      // 1b. Komen & Balasan Berita (/news/{newsId}/comments/{commentId})
      match /comments/{commentId} {
        allow get: if isValidId(commentId) && canReadNewsArticle(newsId);
        allow list: if canReadNewsArticle(newsId);

        allow create: if isSignedIn() &&
          isValidId(newsId) &&
          isValidId(commentId) &&
          canReadNewsArticle(newsId) &&
          isValidNewsComment(incoming(), newsId) &&
          incoming().authorId == request.auth.uid &&
          incoming().keys().hasAll(['newsId', 'authorId', 'authorName', 'text', 'createdAt']) &&
          incoming().keys().hasOnly([
            'newsId', 'authorId', 'authorName', 'text',
            'parentCommentId', 'replyToAuthorName', 'createdAt'
          ]);

        allow delete: if isSignedIn() &&
          isValidId(newsId) &&
          isValidId(commentId) && (
            existing().authorId == request.auth.uid || isAdmin()
          );
      }
    }

    // 2. Jadwal Kegiatan Gereja (/schedules/{scheduleId})
    match /schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && (
        existing().published == true ||
        (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin()))
      );

      allow list: if resource.data.published == true || (
        isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          isBootstrappedAdmin()
        )
      );

      allow create: if isSignedIn() &&
        isValidId(scheduleId) &&
        isValidChurchSchedule(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'description', 'category', 'dateLabel', 'timeLabel',
          'location', 'speaker', 'sortOrder', 'recurring', 'published',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'description', 'category', 'dateLabel', 'timeLabel',
          'location', 'speaker', 'sortOrder', 'recurring', 'published',
          'featuredInNews', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(scheduleId) &&
        isValidChurchSchedule(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'category', 'dateLabel', 'timeLabel',
          'location', 'speaker', 'sortOrder', 'recurring', 'published',
          'featuredInNews', 'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isSignedIn() && isValidId(scheduleId) && isAdmin();
    }

    // 3. Galeri Foto Interaktif (/gallery_photos/{photoId})
    match /gallery_photos/{photoId} {
      allow get: if isValidId(photoId) && (
        existing().published == true ||
        (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin()))
      );

      allow list: if resource.data.published == true || (
        isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          isBootstrappedAdmin()
        )
      );

      allow create: if isSignedIn() &&
        isValidId(photoId) &&
        isValidGalleryPhoto(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().likesCount == 0 &&
        incoming().keys().hasAll([
          'title', 'caption', 'category', 'eventDate', 'coverPreset',
          'likesCount', 'published', 'authorId', 'photographerName',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'caption', 'category', 'eventDate', 'coverPreset',
          'likesCount', 'published', 'authorId', 'photographerName',
          'imageUrl', 'imageBase64', 'extraImagesBase64', 'createdAt', 'updatedAt'
        ]) &&
        isAdmin();

      // Action-Based Update: Admin metadata edit OR Jemaat atomic Like/Unlike
      allow update: if isSignedIn() &&
        isValidId(photoId) &&
        isValidGalleryPhoto(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Admin content edit
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'caption', 'category', 'eventDate', 'coverPreset',
            'published', 'photographerName', 'imageUrl', 'imageBase64', 'extraImagesBase64', 'updatedAt'
          ])) ||
          // Action 2: Jemaat atomic like (+1) paired with /users/{uid}/liked_photos/{photoId}
          (existing().published == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
            incoming().likesCount == existing().likesCount + 1 &&
            existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/liked_photos/$(photoId))) ||
          // Action 3: Jemaat atomic unlike (-1) paired with deleting /users/{uid}/liked_photos/{photoId}
          (existing().published == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
            incoming().likesCount == existing().likesCount - 1 &&
            !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/liked_photos/$(photoId)))
        );

      allow delete: if isSignedIn() && isValidId(photoId) && isAdmin();

      // 3b. Komen & Balasan Galeri (/gallery_photos/{photoId}/comments/{commentId})
      match /comments/{commentId} {
        allow get: if isValidId(commentId) && canReadGalleryPhoto(photoId);
        allow list: if canReadGalleryPhoto(photoId);

        allow create: if isSignedIn() &&
          isValidId(photoId) &&
          isValidId(commentId) &&
          canReadGalleryPhoto(photoId) &&
          isValidGalleryComment(incoming(), photoId) &&
          incoming().authorId == request.auth.uid &&
          incoming().keys().hasAll(['photoId', 'authorId', 'authorName', 'text', 'createdAt']) &&
          incoming().keys().hasOnly([
            'photoId', 'authorId', 'authorName', 'text',
            'parentCommentId', 'replyToAuthorName', 'createdAt'
          ]);

        allow delete: if isSignedIn() &&
          isValidId(photoId) &&
          isValidId(commentId) && (
            existing().authorId == request.auth.uid || isAdmin()
          );
      }
    }

    // 4. Daftar Admin Gereja (/admins/{adminUid})
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (
        request.auth.uid == adminUid || isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.addedBy == request.auth.uid || isBootstrappedAdmin()
      );

      allow create: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminMember(incoming()) &&
        incoming().addedBy == request.auth.uid &&
        incoming().keys().hasAll(['displayName', 'roleTitle', 'addedBy', 'createdAt']) &&
        incoming().keys().hasOnly(['displayName', 'roleTitle', 'addedBy', 'createdAt']) &&
        isAdmin();

      allow delete: if isSignedIn() && isValidId(adminUid) && isAdmin();
    }

    // 5. Profil Jemaat (/users/{userId}) - Owner-isolated; Admin dapat memantau daftar pengguna login Google
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().keys().hasAll(['displayName', 'fellowshipGroup', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['displayName', 'email', 'fellowshipGroup', 'photoBase64', 'createdAt', 'updatedAt', 'lastLoginAt']);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'fellowshipGroup', 'photoBase64', 'updatedAt', 'lastLoginAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 6. Bookmark Jemaat (/users/{userId}/bookmarks/{bookmarkId})
      match /bookmarks/{bookmarkId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(bookmarkId);

        allow create: if isOwner(userId) &&
          isValidId(bookmarkId) &&
          isValidUserBookmark(incoming()) &&
          incoming().keys().hasAll(['itemId', 'itemType', 'title', 'createdAt']) &&
          incoming().keys().hasOnly(['itemId', 'itemType', 'title', 'createdAt']);
      }

      // 7. Status Suka Foto (/users/{userId}/liked_photos/{photoId})
      match /liked_photos/{photoId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(photoId);

        allow create: if isOwner(userId) &&
          isValidId(photoId) &&
          isValidPhotoLike(incoming(), photoId) &&
          incoming().keys().hasAll(['photoId', 'createdAt']) &&
          incoming().keys().hasOnly(['photoId', 'createdAt']) &&
          exists(/databases/$(database)/documents/gallery_photos/$(photoId));
      }

      // 8. Token FCM & Preferensi Notifikasi (/users/{userId}/fcm_tokens/{tokenId})
      match /fcm_tokens/{tokenId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(tokenId);

        allow create, update: if isOwner(userId) &&
          isValidId(tokenId) &&
          isValidFcmToken(incoming()) &&
          incoming().keys().hasAll(['token', 'newsEnabled', 'schedulesEnabled', 'updatedAt']) &&
          incoming().keys().hasOnly(['token', 'newsEnabled', 'schedulesEnabled', 'updatedAt']);
      }
    }

    // 9. Outbox & Stream Notifikasi Push Real-Time (/notification_events/{eventId})
    match /notification_events/{eventId} {
      allow get: if isValidId(eventId) && (
        existing().published == true ||
        (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin()))
      );

      allow list: if resource.data.published == true || (
        isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          isAdmin()
        )
      );

      allow create: if isSignedIn() &&
        isValidId(eventId) &&
        isValidNotificationEvent(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'body', 'eventType', 'targetId', 'topic',
          'published', 'authorId', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'body', 'eventType', 'targetId', 'topic',
          'published', 'authorId', 'createdAt'
        ]) && (
          (isAdmin() &&
            incoming().published == true &&
            incoming().eventType in ['NEWS', 'SCHEDULE'] &&
            incoming().topic in ['sib_toburon_news', 'sib_toburon_schedules']) ||
          (hasVerifiedEmail() &&
            incoming().published == false &&
            incoming().eventType == 'MEMBER_REGISTERED' &&
            incoming().topic == 'sib_toburon_admin_members' &&
            incoming().targetId == 'member_' + request.auth.uid)
        );

      allow delete: if isSignedIn() && isValidId(eventId) && isAdmin();
    }

    // 10. Direktori Nama Penuh Ahli Jemaat (/church_members/{memberId}) - Admin & pemilik daftar diri (Guest disekat)
    match /church_members/{memberId} {
      allow get: if isSignedIn() && isValidId(memberId) && (
        existing().published == true ||
        existing().authorId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.published == true ||
        resource.data.authorId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isSignedIn() &&
        isValidId(memberId) &&
        isValidChurchMemberPublic(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().published == true &&
        incoming().keys().hasAll(['fullName', 'gender', 'baptismStatus', 'published', 'authorId', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['fullName', 'gender', 'baptismStatus', 'passportPhotoBase64', 'published', 'authorId', 'createdAt', 'updatedAt']) && (
          isAdmin() ||
          (hasVerifiedEmail() && memberId == 'member_' + request.auth.uid)
        );

      allow update: if isSignedIn() &&
        isValidId(memberId) &&
        isValidChurchMemberPublic(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'gender', 'baptismStatus', 'passportPhotoBase64', 'published', 'updatedAt']) && (
          isAdmin() ||
          (incoming().published == existing().published && (
            (hasVerifiedEmail() && existing().authorId == request.auth.uid && memberId == 'member_' + request.auth.uid) ||
            isOwnMemberRecord(memberId)
          ))
        );

      allow delete: if isSignedIn() && isValidId(memberId) && isAdmin();
    }

    // 11. Maklumat Lengkap Ahli Jemaat (/church_member_details/{memberId}) - Admin & pemilik akaun emel terverifikasi sahaja (PII dilindungi)
    match /church_member_details/{memberId} {
      allow get: if isSignedIn() && isValidId(memberId) && (
        isAdmin() ||
        memberId == 'member_' + request.auth.uid ||
        (resource != null && isOwnMemberDetail(existing()))
      );

      allow list: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin() ||
        isOwnMemberDetail(resource.data)
      );

      allow create: if isSignedIn() &&
        isValidId(memberId) &&
        isValidChurchMemberDetail(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().keys().hasAll([
          'fullName', 'gender', 'birthDate', 'baptismStatus', 'denomination',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'fullName', 'gender', 'birthDate', 'baptismStatus', 'denomination', 'maritalStatus',
          'myKadNumber', 'spouseName', 'sibMembershipNumber',
          'passportPhotoBase64', 'memberEmail', 'authorId', 'createdAt', 'updatedAt'
        ]) && (
          isAdmin() ||
          (memberId == 'member_' + request.auth.uid && isOwnMemberDetail(incoming()))
        );

      allow update: if isSignedIn() &&
        isValidId(memberId) &&
        isValidChurchMemberDetail(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'gender', 'birthDate', 'baptismStatus', 'denomination', 'maritalStatus',
          'myKadNumber', 'spouseName', 'sibMembershipNumber',
          'passportPhotoBase64', 'memberEmail', 'updatedAt'
        ]) && (
          isAdmin() ||
          (isOwnMemberDetail(existing()) && isOwnMemberDetail(incoming()))
        );

      allow delete: if isSignedIn() && isValidId(memberId) && isAdmin();
    }

    // 12. Konfigurasi Versi Aplikasi (/app_config/version) - Bacaan umum (get sahaja); hanya Admin boleh ubah
    match /app_config/{configId} {
      allow get: if configId == 'version';
      allow list: if false;

      allow create, update: if isSignedIn() &&
        isAdmin() &&
        configId == 'version' &&
        isValidAppVersionConfig(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'latestVersionCode', 'latestVersionName', 'releaseNotes',
          'updateUrl', 'forceUpdate', 'updatedBy', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'latestVersionCode', 'latestVersionName', 'releaseNotes',
          'updateUrl', 'forceUpdate', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // 13. Kategori Berita Dinamik (/news_categories/{catId}) - Bacaan umum; Admin sahaja boleh urus
    match /news_categories/{catId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
        isAdmin() &&
        isValidId(catId) &&
        isValidDynamicCategory(incoming()) &&
        incoming().code == catId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'code', 'labelMs', 'labelEn', 'sortOrder', 'updatedBy', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'code', 'labelMs', 'labelEn', 'sortOrder', 'updatedBy', 'updatedAt'
        ]);

      allow update: if isSignedIn() &&
        isAdmin() &&
        isValidId(catId) &&
        isValidDynamicCategory(incoming()) &&
        incoming().code == existing().code &&
        incoming().code == catId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'labelMs', 'labelEn', 'sortOrder', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isAdmin() && isValidId(catId);
    }

    // 14. Kategori Jadual Dinamik (/schedule_categories/{catId}) - Bacaan umum; Admin sahaja boleh urus
    match /schedule_categories/{catId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
        isAdmin() &&
        isValidId(catId) &&
        isValidDynamicCategory(incoming()) &&
        incoming().code == catId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'code', 'labelMs', 'labelEn', 'sortOrder', 'updatedBy', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'code', 'labelMs', 'labelEn', 'sortOrder', 'updatedBy', 'updatedAt'
        ]);

      allow update: if isSignedIn() &&
        isAdmin() &&
        isValidId(catId) &&
        isValidDynamicCategory(incoming()) &&
        incoming().code == existing().code &&
        incoming().code == catId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'labelMs', 'labelEn', 'sortOrder', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isAdmin() && isValidId(catId);
    }
  }
}
